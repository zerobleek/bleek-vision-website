{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bleek-vision-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/assets/calmaxx/*"]
  },
  "kv_namespaces": [
    { "binding": "WAITLIST", "id": "a50cfc5126bf40a3ad9078b7220cb817" }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  },
  "vars": {
    "RESEND_SEGMENT_ID": "REPLACE_WITH_YOUR_CIPHER_PROTOCOL_SEGMENT_ID",
    "MAIL_FROM": "The Archivist <intake@mail.bleekvision.com>"
  }
  // Secrets (never put these here — use wrangler secret put):
  //   wrangler secret put RESEND_API_KEY
  //   wrangler secret put SIGNUP_SECRET
  //   wrangler secret put TURNSTILE_SECRET
}
